# Copia este archivo a .env y pon tu key. Nunca subas .env al repositorio.
OPENAI_API_KEY=
PROVIDER=openai
SOURCE_LANG=es
TARGET_LANG=en
# Opcional: puerto del servidor local (por defecto 5173)
PORT=5173
# Soniox (proveedor alternativo, más simultáneo y con glosario)
SONIOX_API_KEY=
# Opcional: voz de Soniox (por defecto Adrian)
SONIOX_VOICE=
