# Copia este archivo a .env y pon tu key. Nunca subas .env al repositorio.
OPENAI_API_KEY=
PROVIDER=openai
SOURCE_LANG=es
TARGET_LANG=en
# Opcional: puerto del servidor local (por defecto 5173)
PORT=5173
# Soniox (proveedor alternativo, más simultáneo y con glosario)
SONIOX_API_KEY=
# Opcional: voz de Soniox (por defecto Adrian)
SONIOX_VOICE=
# Google Gemini Live Translate (el modelo de traducción de Google Meet). Key de aistudio.google.com
GEMINI_API_KEY=

# Solo al publicar el servidor en internet (ver README, "Compartir con otras personas"):
# HOST=0.0.0.0
# CODIGO_ACCESO=
