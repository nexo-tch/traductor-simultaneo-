{
  "name": "traductor-simultaneo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Probador de fluidez: traducción simultánea español ↔ inglés (Fase 1)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "build:extension": "vite build --config vite.extension.config.ts",
    "dev:extension": "vite build --config vite.extension.config.ts --watch",
    "zip:extension": "npm run build:extension && cd dist/extension && rm -f ../traductor-extension.zip && zip -qr ../traductor-extension.zip .",
    "start": "tsx server/index.ts --produccion",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@soniox/client": "^2.4.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
