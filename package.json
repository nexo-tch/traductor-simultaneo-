{
  "name": "traductor-simultaneo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Probador de fluidez: traducción simultánea español ↔ inglés (Fase 1)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
